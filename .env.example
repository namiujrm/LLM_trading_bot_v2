# =====================================================================
# LLM TRADING BOT V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# All variables are required. Silent fallbacks and default values are prohibited.
# =====================================================================

# --- Database (TimescaleDB + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=trading_bot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MAX_CONNECTIONS=20

# --- Redis Store & Sliding Window Rate Limiter ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# --- Binance Futures API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW_MS=5000

# --- 9router LLM Gateway ---
NINEROUTER_PORT=20128
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=your_9router_api_key_here
NINEROUTER_TIMEOUT_SECONDS=60.0

# --- Telegram Notification & Controller ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
